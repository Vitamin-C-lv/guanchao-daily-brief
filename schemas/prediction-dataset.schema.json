{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prediction-dataset.schema.json",
  "title": "Guanchao immutable prediction dataset manifest",
  "type": "object",
  "required": ["schemaVersion", "datasetId", "status", "market", "createdAt", "codeCommit", "dataAsOf", "taxonomy", "benchmark", "calendar", "contracts", "horizons", "targets", "panel", "maturity", "quality", "sourceManifest", "warnings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "datasetId": {"type": "string", "pattern": "^a-share-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}$"},
    "status": {"enum": ["active", "candidate", "legacy_recovered", "reproduction_unavailable"]},
    "market": {"const": "A_SHARE"},
    "createdAt": {"type": "string"},
    "codeCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "dataAsOf": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "taxonomy": {"type": "object", "required": ["id", "sha256"]},
    "benchmark": {"type": "object", "required": ["code", "name", "contractVersion", "source"], "properties": {"code": {"const": "000985"}}},
    "calendar": {"type": "object", "required": ["id", "sha256"]},
    "contracts": {"type": "object", "required": ["dataset", "features", "labels", "benchmark"], "properties": {"dataset": {"const": "1"}, "features": {"const": "a-share-price-volume-v2"}, "labels": {"const": "a-share-labels-v1"}, "benchmark": {"const": "a-share-benchmark-csi-all-share-v1"}}},
    "horizons": {"const": [1, 5, 20]},
    "targets": {"const": ["absolute_up", "outperformance", "top_quartile", "expected_excess"]},
    "panel": {"type": "object", "required": ["path", "sha256", "uncompressedSha256", "rows", "dates", "sectors", "columns", "compressedBytes", "uncompressedBytes"]},
    "maturity": {"type": "object", "required": ["1", "5", "20"]},
    "quality": {"type": "object", "required": ["missingFeatureValues", "missingLabelValuesByHorizon", "duplicateKeys", "invalidTargetDates", "crossSectionSizeMin", "crossSectionSizeMax"]},
    "sourceManifest": {"type": "object", "required": ["path", "sha256"]},
    "warnings": {"type": "array"}
  }
}
