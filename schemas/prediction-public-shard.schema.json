{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanchao.local/schemas/prediction-public-shard.schema.json",
  "title": "Public prediction history shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "yearMonth", "summary", "contract", "records"],
  "properties": {
    "schemaVersion": {"const": 1}, "contractVersion": {"const": "prediction-ledger-v1"},
    "yearMonth": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["recordCount", "markets", "modelVersions", "statusSummary", "legacyRecordCount", "currentRecordCount", "evaluatedRecordCount", "pendingRecordCount"],
      "properties": {
        "recordCount": {"type": "integer", "minimum": 0}, "markets": {"type": "array", "items": {"type": "string"}},
        "modelVersions": {"type": "array", "items": {"type": "string"}},
        "statusSummary": {"type": "object", "additionalProperties": false, "required": ["published", "abstained", "insufficient_data", "not_applicable"], "properties": {
          "published": {"type": "integer", "minimum": 0}, "abstained": {"type": "integer", "minimum": 0},
          "insufficient_data": {"type": "integer", "minimum": 0}, "not_applicable": {"type": "integer", "minimum": 0}
        }},
        "legacyRecordCount": {"type": "integer", "minimum": 0}, "currentRecordCount": {"type": "integer", "minimum": 0},
        "evaluatedRecordCount": {"type": "integer", "minimum": 0}, "pendingRecordCount": {"type": "integer", "minimum": 0}
      }
    },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["authoritativeLedger", "legacyExcludedFromCurrentMetrics", "probabilityTargetsNeverMixed", "internalFieldsExcluded"],
      "properties": {
        "authoritativeLedger": {"const": "data/prediction-ledger"}, "legacyExcludedFromCurrentMetrics": {"const": true},
        "probabilityTargetsNeverMixed": {"const": true}, "internalFieldsExcluded": {"const": true}
      }
    },
    "records": {"type": "array", "items": {"type": "object", "not": {"anyOf": [
      {"required": ["codeCommit"]}, {"required": ["sourceHashes"]}, {"required": ["integrity"]}, {"required": ["localPath"]}
    ]}}}
  }
}
