{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanchao.local/schemas/market-breadth-v1.schema.json",
  "title": "A-share market breadth v1 immutable snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "market", "asOf", "constituentPointInTimePolicy", "sourceStatus", "sourceHashes", "summary", "sectors", "contentHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "a-share-market-breadth-v1" },
    "market": { "const": "A_SHARE" },
    "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "constituentPointInTimePolicy": { "const": "current-session-only; no current membership historical backfill" },
    "sourceStatus": { "type": "object" },
    "sourceHashes": { "type": "object" },
    "summary": { "type": "object" },
    "sectors": { "type": "array", "minItems": 12, "maxItems": 12 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
