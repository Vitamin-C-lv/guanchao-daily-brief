{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanchao.local/schemas/prediction-publication-gate-v1.schema.json",
  "title": "HK/US publication gate registry v1",
  "description": "Per market/object/horizon publication gate policy for HK/US research models. A-share keeps the existing frozen production gate and is never copied or loosened here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "generatedAt", "policy", "markets"],
  "properties": {
    "schemaVersion": {"const": "prediction-publication-gate-v1"},
    "contractVersion": {"const": "hk-us-publication-gate-v1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "policy": {"$ref": "#/$defs/policy"},
    "markets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/market"}}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aShareGateReference",
        "minValidFolds",
        "minOosSamples",
        "brierSkillMin",
        "logLossSkillMin",
        "foldBrierSkillPassShare",
        "aucMin",
        "calibrationSlopeRange",
        "calibrationInterceptAbsMax",
        "probabilityStdMin",
        "coverageMin",
        "maxSingleFoldImprovementShare"
      ],
      "properties": {
        "aShareGateReference": {"type": "string"},
        "minValidFolds": {"type": "integer", "minimum": 1},
        "minOosSamples": {
          "type": "object",
          "additionalProperties": false,
          "required": ["1", "5", "20"],
          "properties": {"1": {"type": "integer", "minimum": 1}, "5": {"type": "integer", "minimum": 1}, "20": {"type": "integer", "minimum": 1}}
        },
        "brierSkillMin": {"type": "number"},
        "logLossSkillMin": {"type": "number"},
        "foldBrierSkillPassShare": {"type": "number", "minimum": 0, "maximum": 1},
        "aucMin": {"type": "number"},
        "calibrationSlopeRange": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "calibrationInterceptAbsMax": {"type": "number", "minimum": 0},
        "probabilityStdMin": {"type": "number", "minimum": 0},
        "coverageMin": {"type": "number", "minimum": 0, "maximum": 1},
        "maxSingleFoldImprovementShare": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marketId", "label", "researchMarketKey", "objects"],
      "properties": {
        "marketId": {"type": "string"},
        "label": {"type": "string"},
        "researchMarketKey": {"type": "string"},
        "objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/object"}}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId", "label", "target", "horizons", "requiredSourceRoles"],
      "properties": {
        "objectId": {"type": "string"},
        "label": {"type": "string"},
        "target": {"type": "string"},
        "modelVersion": {"type": ["string", "null"]},
        "horizons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [1, 5, 20]}},
        "requiredSourceRoles": {"type": "array", "items": {"type": "string"}},
        "expectedStage2Status": {"enum": ["abstained", "insufficient_data", "unavailable"]}
      }
    }
  }
}
