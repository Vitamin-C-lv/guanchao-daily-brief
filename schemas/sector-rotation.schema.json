{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanchao.local/schemas/sector-rotation.schema.json",
  "title": "观潮行业轮动指数",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "model", "markets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "model": { "$ref": "#/$defs/model" },
    "markets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/market" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sourceIndexes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "publisher", "url", "tier"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "tier": { "enum": ["official", "authoritative", "major-media"] },
        "evidenceClass": {
          "enum": [
            "official-primary",
            "company-filing",
            "primary-research",
            "exchange-market-data",
            "vendor-market-data",
            "vendor-estimate",
            "major-media"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "trainedAt", "trainingStart", "trainingEnd", "method", "features", "backtest"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 80 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "trainedAt": { "type": "string", "format": "date-time" },
        "trainingStart": { "$ref": "#/$defs/date" },
        "trainingEnd": { "$ref": "#/$defs/date" },
        "method": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "backtest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary"],
          "properties": {
            "status": { "enum": ["passed", "limited", "insufficient"] },
            "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "version", "effectiveDate"],
      "properties": {
        "owner": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 },
        "effectiveDate": { "$ref": "#/$defs/date" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "value": { "type": "string", "minLength": 1, "maxLength": 40 },
        "tone": { "enum": ["positive", "negative", "neutral", "warning"] }
      }
    },
    "evidencePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "observation", "sourceIndexes"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 50 },
        "observation": { "type": "string", "minLength": 1, "maxLength": 260 },
        "sourceIndexes": { "$ref": "#/$defs/sourceIndexes" }
      }
    },
    "observedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector", "rank", "score", "direction", "signal", "metrics", "sourceIndexes"],
      "properties": {
        "sector": { "type": "string", "minLength": 1, "maxLength": 60 },
        "code": { "type": "string", "minLength": 1, "maxLength": 30 },
        "rank": { "type": "integer", "minimum": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "direction": { "enum": ["leading", "strengthening", "neutral", "weakening", "lagging"] },
        "signal": { "type": "string", "minLength": 1, "maxLength": 240 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/metric" }
        },
        "sourceIndexes": { "$ref": "#/$defs/sourceIndexes" }
      }
    },
    "forecastItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forecastId", "sector", "rank", "upProbability", "historicalBaseRate", "probabilityEdge", "calibrationRange", "probabilityTier", "direction", "confidence", "calibrationBasis", "claim", "evidence", "counterEvidence", "trigger", "invalidation", "dueDate"],
      "properties": {
        "forecastId": { "type": "string", "minLength": 12, "maxLength": 100, "pattern": "^fr-[a-z0-9-]+$" },
        "sector": { "type": "string", "minLength": 1, "maxLength": 60 },
        "code": { "type": "string", "minLength": 1, "maxLength": 30 },
        "rank": { "type": "integer", "minimum": 1 },
        "upProbability": { "type": "number", "minimum": 0, "maximum": 100 },
        "historicalBaseRate": { "type": "number", "minimum": 0, "maximum": 100 },
        "probabilityEdge": { "type": "number", "minimum": -100, "maximum": 100 },
        "calibrationRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high", "level"],
          "properties": {
            "low": { "type": "number", "minimum": 0, "maximum": 100 },
            "high": { "type": "number", "minimum": 0, "maximum": 100 },
            "level": { "const": "90%" }
          }
        },
        "probabilityTier": { "enum": ["model-calibrated", "model-shrunk", "historical-base-rate"] },
        "direction": { "enum": ["strong-up", "up", "range", "down", "strong-down"] },
        "confidence": { "enum": ["low", "medium", "medium-high"] },
        "calibrationBasis": { "type": "string", "minLength": 20, "maxLength": 360 },
        "claim": { "type": "string", "minLength": 1, "maxLength": 280 },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/evidencePoint" }
        },
        "counterEvidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/evidencePoint" }
        },
        "trigger": { "type": "string", "minLength": 1, "maxLength": 220 },
        "invalidation": { "type": "string", "minLength": 1, "maxLength": 220 },
        "dueDate": { "$ref": "#/$defs/date" }
      }
    },
    "linePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "value"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "value": { "type": "number" }
      }
    },
    "lineSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "points"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 60,
          "items": { "$ref": "#/$defs/linePoint" }
        }
      }
    },
    "lineChart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "unit", "note", "asOf", "sourceIndexes", "series"],
      "properties": {
        "type": { "const": "line" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "note": { "type": "string", "minLength": 1, "maxLength": 240 },
        "asOf": { "$ref": "#/$defs/date" },
        "sourceIndexes": { "$ref": "#/$defs/sourceIndexes" },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/lineSeries" }
        }
      }
    },
    "candlestickPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "open", "high", "low", "close"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" }
      }
    },
    "candlestickChart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "unit", "note", "asOf", "sourceIndexes", "points"],
      "properties": {
        "type": { "const": "candlestick" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "note": { "type": "string", "minLength": 1, "maxLength": 240 },
        "asOf": { "$ref": "#/$defs/date" },
        "sourceIndexes": { "$ref": "#/$defs/sourceIndexes" },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 60,
          "items": { "$ref": "#/$defs/candlestickPoint" }
        }
      }
    },
    "chart": {
      "oneOf": [
        { "$ref": "#/$defs/lineChart" },
        { "$ref": "#/$defs/candlestickChart" }
      ]
    },
    "charts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/chart" }
    },
    "observedReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "asOf", "note", "items"],
      "properties": {
        "kind": { "const": "observed" },
        "status": { "const": "ready" },
        "asOf": { "$ref": "#/$defs/date" },
        "note": { "type": "string", "minLength": 1, "maxLength": 300 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/observedItem" }
        },
        "charts": { "$ref": "#/$defs/charts" }
      }
    },
    "observedInsufficient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "asOf", "reason"],
      "properties": {
        "kind": { "const": "observed" },
        "status": { "const": "insufficient" },
        "asOf": { "$ref": "#/$defs/date" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "forecastReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "asOf", "dueDate", "sessions", "note", "items"],
      "properties": {
        "kind": { "const": "forecast" },
        "status": { "const": "ready" },
        "asOf": { "$ref": "#/$defs/date" },
        "dueDate": { "$ref": "#/$defs/date" },
        "sessions": { "enum": [1, 5, 20] },
        "note": { "type": "string", "minLength": 1, "maxLength": 300 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/forecastItem" }
        },
        "charts": { "$ref": "#/$defs/charts" }
      }
    },
    "forecastInsufficient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "asOf", "sessions", "reason"],
      "properties": {
        "kind": { "const": "forecast" },
        "status": { "const": "insufficient" },
        "asOf": { "$ref": "#/$defs/date" },
        "dueDate": { "$ref": "#/$defs/date" },
        "sessions": { "enum": [1, 5, 20] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "mode", "asOf", "status", "taxonomy", "note", "sources", "horizons"],
      "properties": {
        "id": { "enum": ["a-share", "hk", "us"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 30 },
        "mode": { "enum": ["industry", "major-index"] },
        "asOf": { "$ref": "#/$defs/date" },
        "status": { "enum": ["ready", "insufficient"] },
        "taxonomy": { "$ref": "#/$defs/taxonomy" },
        "note": { "type": "string", "minLength": 1, "maxLength": 400 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
        "sources": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/source" }
        },
        "horizons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current", "tomorrow", "oneWeek", "oneMonth"],
          "properties": {
            "current": {
              "oneOf": [
                { "$ref": "#/$defs/observedReady" },
                { "$ref": "#/$defs/observedInsufficient" }
              ]
            },
            "tomorrow": {
              "oneOf": [
                { "$ref": "#/$defs/forecastReady" },
                { "$ref": "#/$defs/forecastInsufficient" }
              ]
            },
            "oneWeek": {
              "oneOf": [
                { "$ref": "#/$defs/forecastReady" },
                { "$ref": "#/$defs/forecastInsufficient" }
              ]
            },
            "oneMonth": {
              "oneOf": [
                { "$ref": "#/$defs/forecastReady" },
                { "$ref": "#/$defs/forecastInsufficient" }
              ]
            }
          }
        }
      }
    }
  }
}
