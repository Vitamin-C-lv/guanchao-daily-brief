{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanchao.local/schemas/global-market-brief-public-dto-v1.schema.json",
  "title": "观潮全球主文章公开页面 DTO",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataAsOf", "mainArticle", "schemaVersion", "specialReports"],
  "properties": {
    "schemaVersion": { "const": "global-market-brief-public-dto-v1" },
    "dataAsOf": { "type": "string", "format": "date" },
    "mainArticle": { "$ref": "#/$defs/mainArticleCard" },
    "specialReports": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/specialReportCard" }
    }
  },
  "$defs": {
    "marketTags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["US", "HK", "A_SHARE", "GLOBAL"] }
    },
    "logicEdgeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceStatus", "from", "relation", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1, "maxLength": 160 },
        "relation": { "type": "string", "minLength": 1, "maxLength": 160 },
        "to": { "type": "string", "minLength": 1, "maxLength": 160 },
        "evidenceStatus": { "enum": ["confirmed", "partially_confirmed", "pending", "reversed"] }
      }
    },
    "mainArticleCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["articleUrl", "conclusion", "dataAsOf", "dek", "logicChain", "marketTags", "sourceCount", "title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "dek": { "type": "string", "minLength": 1, "maxLength": 500 },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "logicChain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/logicEdgeSummary" }
        },
        "marketTags": { "$ref": "#/$defs/marketTags" },
        "dataAsOf": { "type": "string", "format": "date" },
        "sourceCount": { "type": "integer", "minimum": 1 },
        "articleUrl": { "type": "string", "pattern": "^/articles/[a-z0-9][a-z0-9._-]{1,79}/$" }
      }
    },
    "specialReportCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["articleUrl", "conclusion", "marketTags", "title", "triggerType"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "triggerType": { "enum": ["abnormal_market_move", "central_bank_policy", "macro_data_surprise", "geopolitical_risk", "major_earnings", "china_policy", "theme_reversal", "systemic_risk"] },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "marketTags": { "$ref": "#/$defs/marketTags" },
        "articleUrl": { "type": "string", "pattern": "^/articles/[a-z0-9][a-z0-9._-]{1,79}/$" }
      }
    }
  }
}
