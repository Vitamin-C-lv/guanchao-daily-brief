{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanchao.local/schemas/prediction-weekly-review.schema.json",
  "title": "Weekly prediction review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "isoWeek", "generatedAt", "counts", "metrics", "metricReasons", "targetMetrics", "slices", "modelVersionComparison", "abstainReasonDistribution", "largestErrors", "bestCalls", "recommendations", "machineRecommendations", "policy"],
  "properties": {
    "schemaVersion": {"const": 1}, "contractVersion": {"const": "prediction-ledger-v1"},
    "isoWeek": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"}, "generatedAt": {"type": "string", "format": "date-time"},
    "counts": {"type": "object"}, "metrics": {"type": "object"}, "metricReasons": {"type": "object"},
    "targetMetrics": {"type": "object"}, "slices": {"type": "array", "items": {"type": "object"}},
    "modelVersionComparison": {"type": "object"}, "recommendations": {"type": "array", "items": {"type": "string"}},
    "abstainReasonDistribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "largestErrors": {"type": "array", "items": {"type": "object"}}, "bestCalls": {"type": "array", "items": {"type": "object"}},
    "machineRecommendations": {
      "type": "object", "additionalProperties": false,
      "required": ["recurringFailureModes", "featureCoverageProblems", "calibrationWarnings", "regimeInstability", "recommendedResearchActions", "gatePolicy"],
      "properties": {
        "recurringFailureModes": {"type": "array", "items": {"type": "string"}},
        "featureCoverageProblems": {"type": "array", "items": {"type": "string"}},
        "calibrationWarnings": {"type": "array", "items": {"type": "string"}},
        "regimeInstability": {"type": "array", "items": {"type": "string"}},
        "recommendedResearchActions": {"type": "array", "items": {"type": "string"}},
        "gatePolicy": {"const": "do_not_lower_automatically"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["legacyExcludedFromCurrentMetrics", "pendingAndAbstainedNeverCountedAsWrong", "probabilityTargetsNeverMixed"],
      "properties": {
        "legacyExcludedFromCurrentMetrics": {"const": true}, "pendingAndAbstainedNeverCountedAsWrong": {"const": true},
        "probabilityTargetsNeverMixed": {"const": true}
      }
    }
  }
}
