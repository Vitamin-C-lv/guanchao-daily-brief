{
  "name": "market-brief-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:rotation": "node scripts/validate-sector-rotation.mjs",
    "validate:prediction-history": "node scripts/validate-prediction-history.mjs",
    "validate:prediction-diagnostics": "node scripts/validate-prediction-diagnostics.mjs",
    "validate:prediction-dataset": "node scripts/validate-prediction-dataset.mjs",
    "validate:sector-details": "node scripts/validate-sector-details.mjs",
    "validate:rotation-events": "node scripts/validate-rotation-events.mjs",
    "validate:market-observer": "node scripts/validate-market-observer.mjs",
    "test:market-observer": "node --test scripts/market-observer-domain.test.mjs",
    "test:prediction-python": "uv run --no-project --python 3.12 --with requests python -m unittest scripts/test_prediction_contract_python.py",
    "test:prediction-dataset": "uv run --no-project --python 3.12 --with requests --with numpy python scripts/test_prediction_dataset.py && node --test scripts/prediction-dataset.test.mjs",
    "test": "node --test scripts/market-observer-domain.test.mjs scripts/prediction-contract.test.mjs scripts/prediction-dataset.test.mjs",
    "archive:market-observer": "node scripts/archive-market-observer.mjs",
    "rotation:fetch": "node scripts/run-sector-rotation.mjs fetch",
    "rotation:signals": "node scripts/run-sector-rotation.mjs signals",
    "rotation:features": "node scripts/run-sector-rotation.mjs features",
    "rotation:probability-train": "node scripts/run-sector-rotation.mjs probability-train",
    "rotation:history": "node scripts/run-sector-rotation.mjs history",
    "rotation:infer": "node scripts/run-sector-rotation.mjs infer",
    "rotation:refresh": "pnpm rotation:signals && node scripts/run-sector-rotation.mjs refresh",
    "rotation:events-append": "node scripts/run-sector-rotation.mjs events-append",
    "rotation:events-prune": "node scripts/run-sector-rotation.mjs events-prune",
    "market:data:daily": "node scripts/run-market-evidence.mjs daily",
    "market:data:weekly": "node scripts/run-market-evidence.mjs weekly",
    "market:data:health": "node scripts/run-market-evidence.mjs health",
    "validate:market-data": "node scripts/validate-market-evidence.mjs",
    "test:market-data": "node scripts/run-market-evidence.mjs test",
    "validate:brief": "node scripts/validate-brief.mjs",
    "validate:weekly": "node scripts/validate-weekly.mjs",
    "validate:assets": "node scripts/validate-generated-assets.mjs",
    "visual:publish": "node scripts/publish-generated-image.mjs",
    "assets:prune": "node scripts/validate-generated-assets.mjs --prune",
    "archive:brief": "node scripts/archive-brief.mjs",
    "archive:weekly": "node scripts/archive-weekly-report.mjs",
    "context:weekly": "node scripts/collect-week-context.mjs",
    "check": "pnpm validate:rotation && pnpm validate:prediction-history && pnpm validate:prediction-diagnostics && pnpm validate:prediction-dataset && pnpm validate:sector-details && pnpm validate:rotation-events && pnpm validate:market-observer && pnpm validate:market-data && pnpm test && pnpm test:prediction-dataset && pnpm test:market-data && pnpm test:prediction-python && pnpm validate:brief && pnpm validate:weekly && pnpm validate:assets && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ajv": "^8.20.0",
    "sharp": "0.34.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.9.0"
}
