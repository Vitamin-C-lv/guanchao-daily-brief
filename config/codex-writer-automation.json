{
  "schemaVersion": "codex-writer-automation-v2",
  "publicationEnabled": true,
  "productionApplyRequiresExplicitWrite": true,
  "runtime": {
    "projectPath": "D:/Guanchao-Workspace/runtime/local-writer-runtime",
    "repositoryPath": "D:/Guanchao-Workspace/repo/guanchao-daily-brief",
    "recoveryRoot": "C:/Codex-Recovery/GuanchaoWriter",
    "runsRoot": "C:/Codex-Recovery/GuanchaoWriter/runs",
    "automationStatePath": "C:/Codex-Recovery/GuanchaoWriter/automation-state.json",
    "nativeAutomationsRoot": "${CODEX_HOME}/automations",
    "writerPrepare": "scripts/codex-writer-prepare.mjs",
    "writerFinalize": "scripts/codex-writer-finalize.mjs",
    "predictionPublisher": "scripts/run-prediction-publisher.mjs",
    "predictionTaskLauncher": "scripts/run-prediction-publisher-task.ps1",
    "consistencyCheck": "scripts/check-automation-consistency.mjs"
  },
  "writer": {
    "model": "gpt-5.6-luna",
    "researcherMayBrowse": true,
    "writerMayBrowse": true,
    "externalLlmApi": false,
    "apiKeyRequired": false,
    "productionApplyRequiresExplicitWrite": true,
    "memoryBootstrap": "scripts/build-writer-memory-context.mjs"
  },
  "freshness": {
    "timezone": "Asia/Shanghai",
    "requireSameDayPacket": true,
    "staleErrorCode": "STALE_WRITER_PACKET",
    "explanation": "写作前必须刷新官方市场数据并生成当天 Packet；Packet 是已验证事实底座，不是 Writer 主动研究上限。"
  },
  "prediction": {
    "model": null,
    "executorOnly": true,
    "normalPathUsesLlm": false,
    "normalPathLlmTokens": 0,
    "deterministicScript": "scripts/run-prediction-publisher.mjs",
    "trainingForbidden": true,
    "shadowActivationForbidden": true,
    "noOpWhenNoNewTradingDay": true,
    "allowedWritePaths": [
      "content/sector-rotation.json",
      "content/prediction-diagnostics.json",
      "content/prediction-review-latest.json",
      "content/prediction-review/**",
      "data/prediction-ledger/**",
      "public/data/prediction-history/**",
      "content/prediction-history.json",
      "data/sector-rotation/**",
      "data/rotation-model/**",
      "data/market-evidence/**",
      "content/writer-packets/daily-latest.json",
      "content/writer-packets/weekly-latest.json"
    ]
  },
  "schedules": [
    {
      "key": "prediction",
      "label": "Guanchao Prediction Publisher",
      "executor": "windows-task-scheduler",
      "taskName": "Guanchao Prediction Publisher 18-20",
      "legacyAutomationId": "guanchao-prediction-publisher",
      "enabled": false,
      "rrule": "FREQ=DAILY;BYHOUR=18;BYMINUTE=20",
      "timezone": "Asia/Shanghai",
      "promptFile": "prompts/codex-prediction-publisher.md",
      "edition": "prediction"
    },
    {
      "key": "daily",
      "label": "观潮每日晚报 Writer",
      "executor": "codex-automation",
      "automationId": "codex",
      "enabled": false,
      "rrule": "FREQ=DAILY;BYHOUR=20;BYMINUTE=0",
      "timezone": "Asia/Shanghai",
      "promptFile": "prompts/codex-daily-writer.md",
      "edition": "daily"
    },
    {
      "key": "weekly",
      "label": "观潮本机 Codex 周报写手",
      "executor": "codex-automation",
      "automationId": "codex-2",
      "enabled": false,
      "rrule": "FREQ=WEEKLY;BYDAY=SA;BYHOUR=10;BYMINUTE=0",
      "timezone": "Asia/Shanghai",
      "promptFile": "prompts/codex-weekly-writer.md",
      "edition": "weekly"
    }
  ],
  "handover": {
    "status": "pre-merge-safe",
    "candidateSchedulesAreNotProductionActive": true,
    "activeProduction": {
      "prediction": {"automationId":"guanchao-prediction-publisher","rrule":"FREQ=DAILY;BYHOUR=6;BYMINUTE=45","timezone":"Asia/Shanghai","mode":"write-capable","source":"merged origin/main runtime"},
      "daily": {"automationId":"codex","rrule":"FREQ=DAILY;BYHOUR=7;BYMINUTE=30","timezone":"Asia/Shanghai","mode":"write-capable","source":"merged origin/main runtime"},
      "weekly": {"automationId":"codex-2","rrule":"FREQ=WEEKLY;BYDAY=SA;BYHOUR=10;BYMINUTE=0","timezone":"Asia/Shanghai","mode":"write-capable","source":"merged origin/main runtime"}
    },
    "mergeSwitch": {
      "prediction": "old 06:45 OFF only after new 18:20 Write ACTIVE is verified",
      "daily": "old 07:30 OFF only after new 20:00 Write ACTIVE is verified",
      "weekly": "Saturday 10:00 remains unchanged",
      "candidateTask": "Guanchao Prediction Publisher 18-20",
      "candidateMode": "Write after merge and final consistency check"
    },
    "forbiddenProductionPaths": ["D:/周报个人网站"]
  }
}
