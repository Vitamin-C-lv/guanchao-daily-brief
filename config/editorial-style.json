{
  "schemaVersion": "editorial-style-v3",
  "persona": {
    "daily": "观潮日报主笔",
    "weekly": "观潮周报策略主笔"
  },
  "principles": [
    "direct",
    "sharp",
    "restrained",
    "conclusion-first",
    "evidence-dense",
    "plain-language"
  ],
  "analysisUnit": [
    "conclusion",
    "most-important-evidence",
    "market-meaning",
    "one-reversal-condition-or-next-check"
  ],
  "limits": {
    "daily": {
      "defensivePhraseCount": 2,
      "directnessScore": 90,
      "readingMinutes": [
        6,
        9
      ]
    },
    "weekly": {
      "defensivePhraseCount": 4,
      "directnessScore": 85,
      "readingMinutes": [
        12,
        18
      ]
    },
    "maxConsecutiveHedgeSentences": 2,
    "maxSentenceCharacters": 110
  },
  "defensivePhrases": [
    "不构成投资信号",
    "不构成投资建议",
    "不能说明",
    "不能证明",
    "不能提前替代",
    "不能把",
    "仍需等待",
    "仍需观察",
    "持续核验",
    "持续关注",
    "密切关注",
    "值得关注",
    "后续观察",
    "以官方数据为准",
    "以官方声明为准",
    "尚不能确认",
    "有待验证",
    "不排除",
    "可能意味着",
    "未形成新的定性观察"
  ],
  "emptyWatchPhrases": [
    "后续仍需持续关注",
    "后续持续关注",
    "值得持续关注",
    "密切关注后续变化",
    "后续观察市场变化",
    "保持关注"
  ],
  "hedgeWords": [
    "可能",
    "仍需",
    "不能",
    "尚未",
    "有待",
    "或许"
  ],
  "genericTitles": [
    "市场情况更新",
    "今日市场观察",
    "多重因素影响市场",
    "市场综述",
    "每日早报",
    "观潮每日晚报",
    "周报"
  ],
  "readerFacingTechnicalTerms": [
      "provider",
      "coverage",
    "WAF",
    "unavailable",
    "lineage",
    "artifact",
    "schema",
    "insufficient",
    "partial",
    "abstained",
    "evidence observation",
    "published model prediction",
    "publicationStatus",
    "modelAvailability",
    "gateFailures",
    "sourceAsOf",
    "authorityLevel",
    "documentType",
    "implementationStage",
    "publishedAt",
    "effectiveAt",
    "coverage contract",
    "internalLineage",
      "packetId",
      "packet",
    "writerPacket",
    "automation",
    "production gate",
    "market-date-contract",
    "规则观察",
    "合法边界",
    "本地归档为0个独立日期",
    "模型门禁",
    "生产门禁",
    "机器状态"
  ],
  "maxReaderFacingTechnicalTerms": 0,
  "forbiddenTitlePhrases": [
    "采集状态",
    "解读边界",
    "复核条件"
  ],
  "dataLimitationPhrases": [
    "数据缺口",
    "数据不完整",
    "完整收盘尚未",
    "未获得完整",
    "暂缺完整",
    "暂未提供",
    "尚未披露",
    "无法获得",
    "无法核验",
    "未更新",
    "未提供"
  ],
  "maxConsecutiveDataLimitationParagraphs": 1,
  "maxDataLimitationRatio": 0.1,
  "marketMissingExplanationLabels": {
    "a-share": [
      "A股",
      "A 股"
    ],
    "hk": [
      "港股"
    ],
    "us": [
      "美股",
      "美国股市"
    ]
  },
  "maxMissingExplanationsPerMarket": 1,
  "governanceLeakage": [
    "writer-context",
    "writer-result",
    "claimBindings",
    "GENERATION_CONTRACT_FAILURE",
    "机器warning",
    "治理文本",
    "publicationStatus",
    "EvidenceScore",
    "prediction ledger",
    "生产门禁"
  ],
  "tradingInstructionPatterns": [
    "(?:建议|应该|应当|可以|适合|不妨)\\s*(?:买入|卖出|加仓|减仓|做多|做空|建仓|止损)",
    "(?:买入|卖出|加仓|减仓|做多|做空|建仓|止损)\\s*(?:股票|个股|板块|仓位|机会)?"
  ],
  "strongClaimPatterns": [
    "必涨",
    "稳赚",
    "保证收益",
    "确定上涨",
    "确定获利",
    "无风险收益",
    "主力已锁定"
  ],
  "depth": {
    "daily": {
      "chineseCharacterCountMin": 1200,
      "chineseCharacterCountMax": 1800,
      "readingMinutesMin": 6,
      "readingMinutesMax": 9,
      "visualCountMin": 2,
      "scenarioCountMin": 2,
      "termExplanationCountMin": 1,
      "counterEvidenceCountMin": 1,
      "repetitionRatioMax": 0.12
    },
    "weekly": {
      "chineseCharacterCountMin": 2500,
      "chineseCharacterCountMax": 4000,
      "readingMinutesMin": 12,
      "readingMinutesMax": 18,
      "visualCountMin": 4,
      "scenarioCountMin": 3,
      "termExplanationCountMin": 2,
      "counterEvidenceCountMin": 2,
      "repetitionRatioMax": 0.12
    }
  }
}
