{
  "schemaVersion": "writer-job-contract-v2",
  "requestSchemaVersion": "writer-request-v2",
  "resultSchemaVersion": "writer-result-v2",
  "errorSchemaVersion": "writer-error-v1",
  "storage": {
    "requests": "data/writer-jobs/requests/YYYY/MM/<jobId>.json",
    "accepted": "data/writer-jobs/accepted/YYYY/MM/<jobId>.json.gz",
    "index": "data/writer-jobs/index.json",
    "pending": "content/writer-jobs/<edition>-pending.json"
  },
  "identity": "shared canonical JSON SHA-256; createdAt, generatedAt and warnings are audit-only",
  "frozenInputs": ["contextId", "contextArtifactSha256", "writerPromptSha256", "targetSchemaVersion", "targetValidatorSha256"],
  "evidenceBindings": ["quantitative", "qualitative", "sourceMetadata", "baselineDiff"],
  "errorHandling": "writer-error-v1 is only for manual or scheduler failure handling and never enters accepted storage."
}
