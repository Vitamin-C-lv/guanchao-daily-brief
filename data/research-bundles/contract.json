{
  "schemaVersion": "research-contract-v1",
  "sourceRunSchemaVersion": "research-source-run-v1",
  "documentSchemaVersion": "research-document-v1",
  "bundleSchemaVersion": "research-bundle-v1",
  "sourcePolicyVersion": "research-source-policy-v1",
  "storage": {
    "sourceRunArtifact": "data/research-bundles/source-runs/YYYY/MM/<sourceRunId>.json.gz",
    "documentArtifact": "data/research-bundles/documents/YYYY/MM/<documentId>.json.gz",
    "bundleArtifact": "data/research-bundles/bundles/YYYY/MM/<bundleId>.json.gz",
    "index": "data/research-bundles/index.json",
    "dailyLatest": "content/research-bundles/daily-latest.json",
    "weeklyLatest": "content/research-bundles/weekly-latest.json",
    "immutability": "source run, document, and bundle artifacts are never overwritten; index and latest are rebuildable derived views",
    "writerAuthority": "writer-context-v1 must reference an immutable bundle gzip; latest is never authoritative writer input",
    "p1gaArtifacts": "P1-GA creates no index, latest view, production bundle, or gzip data artifact"
  },
  "enums": {
    "sourceClass": ["official-primary", "company-filing", "exchange-market-data", "primary-research", "major-media", "specialist-media", "vendor-market-data", "vendor-estimate", "community-signal", "social-signal"],
    "sourceRunStatus": ["ready", "partial", "stale", "unavailable", "rate_limited", "schema_changed"],
    "snapshotPolicy": ["stored", "hash_only", "none"],
    "language": ["zh", "en", "mixed", "other"],
    "contentType": ["html", "rss", "atom", "json", "xml", "pdf-metadata", "press-release", "filing", "research-paper", "social-post", "community-post"],
    "contentHashBasis": ["response-entity", "feed-item", "structured-record", "metadata-only"],
    "contentHashVersion": ["v1"],
    "observationKind": ["hard-fact", "official-statement", "company-disclosure", "market-event", "calendar-event", "analysis-context", "counterevidence"],
    "basisRelation": ["supports", "contradicts", "context"],
    "evidenceState": ["confirmed", "corroborated", "single-source", "conflicting", "unverified"],
    "eventType": ["macro-release", "monetary-policy", "fiscal-policy", "regulation", "company-event", "market-move", "technology", "commodity", "geopolitics", "calendar", "other"],
    "duplicateClusterMethod": ["exact-url", "content-hash", "publisher-reprint", "semantic-signature"],
    "edition": ["daily", "weekly"],
    "marketScope": ["A_SHARE", "HK", "US", "FED", "GLOBAL"],
    "topic": ["macro", "monetary-policy", "fiscal-policy", "regulation", "market-structure", "company", "technology", "commodities", "geopolitics", "calendar"],
    "coverageStatus": ["ready", "partial", "unavailable"]
  },
  "schemas": {
    "research-source-run-v1": {
      "requiredKeys": ["sourceRunId", "sourceId", "provider", "sourceClass", "adapterId", "adapterVersion", "requestedAt", "asOf", "status", "sourceUrl", "marketScopes", "topics", "coverage", "snapshotPolicy", "rawSnapshotId", "warnings", "integrity"],
      "allowedKeys": ["sourceRunId", "sourceId", "provider", "sourceClass", "adapterId", "adapterVersion", "requestedAt", "asOf", "status", "sourceUrl", "marketScopes", "topics", "coverage", "snapshotPolicy", "rawSnapshotId", "warnings", "integrity"],
      "coverageRequiredKeys": ["itemCount", "note"],
      "coverageAllowedKeys": ["itemCount", "note"],
      "integrityRequiredKeys": ["businessSha256", "sha256"],
      "integrityAllowedKeys": ["businessSha256", "sha256"]
    },
    "research-document-v1": {
      "requiredKeys": ["documentId", "sourceRunId", "sourceId", "publisherId", "publisher", "title", "canonicalUrl", "publishedAt", "accessedAt", "language", "contentType", "contentHashBasis", "contentHashVersion", "contentSha256", "rawSnapshotId", "marketScopes", "topics", "warnings", "integrity"],
      "allowedKeys": ["documentId", "sourceRunId", "sourceId", "publisherId", "publisher", "title", "canonicalUrl", "publishedAt", "accessedAt", "language", "contentType", "contentHashBasis", "contentHashVersion", "contentSha256", "rawSnapshotId", "marketScopes", "topics", "warnings", "integrity"],
      "integrityRequiredKeys": ["businessSha256", "sha256"],
      "integrityAllowedKeys": ["businessSha256", "sha256"]
    },
    "research-bundle-v1": {
      "requiredKeys": ["schemaVersion", "edition", "asOf", "generatedAt", "window", "sourcePolicyVersion", "sourceRuns", "documents", "observations", "events", "duplicateClusters", "coverage", "warnings", "bundleId", "integrity"],
      "allowedKeys": ["schemaVersion", "edition", "asOf", "generatedAt", "window", "sourcePolicyVersion", "sourceRuns", "documents", "observations", "events", "duplicateClusters", "coverage", "warnings", "bundleId", "integrity"],
      "windowRequiredKeys": ["start", "end", "timezone"],
      "windowAllowedKeys": ["start", "end", "timezone"],
      "integrityRequiredKeys": ["businessSha256", "sha256"],
      "integrityAllowedKeys": ["businessSha256", "sha256"],
      "observationRequiredKeys": ["observationId", "kind", "subject", "statement", "occurredAt", "asOf", "marketScopes", "topics", "entities", "evidenceState", "basis", "warnings"],
      "observationAllowedKeys": ["observationId", "kind", "subject", "statement", "occurredAt", "asOf", "marketScopes", "topics", "entities", "evidenceState", "basis", "warnings"],
      "basisRequiredKeys": ["documentId", "relation", "excerpt", "locator"],
      "basisAllowedKeys": ["documentId", "relation", "excerpt", "locator"],
      "eventRequiredKeys": ["eventId", "eventType", "title", "occurredAt", "marketScopes", "topics", "observationIds"],
      "eventAllowedKeys": ["eventId", "eventType", "title", "occurredAt", "marketScopes", "topics", "observationIds"],
      "duplicateClusterRequiredKeys": ["clusterId", "method", "canonicalDocumentId", "memberDocumentIds"],
      "duplicateClusterAllowedKeys": ["clusterId", "method", "canonicalDocumentId", "memberDocumentIds"],
      "coverageRequiredKeys": ["markets", "topics", "totals"],
      "coverageAllowedKeys": ["markets", "topics", "totals"],
      "coverageMarketRequiredKeys": ["market", "status", "documentCount", "observationCount", "reasons"],
      "coverageMarketAllowedKeys": ["market", "status", "documentCount", "observationCount", "reasons"],
      "coverageTopicRequiredKeys": ["topic", "status", "documentCount", "observationCount", "reasons"],
      "coverageTopicAllowedKeys": ["topic", "status", "documentCount", "observationCount", "reasons"],
      "coverageTotalsRequiredKeys": ["sourceRuns", "documents", "observations", "events", "duplicateClusters", "conflictingObservations"],
      "coverageTotalsAllowedKeys": ["sourceRuns", "documents", "observations", "events", "duplicateClusters", "conflictingObservations"]
    },
    "research-source-policy-v1": {
      "requiredKeys": ["rules"],
      "allowedKeys": ["rules"]
    }
  },
  "identity": {
    "hash": "SHA-256 of UTF-8 canonical JSON using one canonical implementation",
    "sourceRun": {
      "formula": ["sourceId", "provider", "sourceClass", "adapterId", "adapterVersion", "asOf", "status", "sourceUrl", "marketScopes", "topics", "coverage", "snapshotPolicy", "rawSnapshotId"],
      "sortBeforeHash": ["marketScopes unique lexicographic", "topics unique lexicographic", "coverage fixed key order"],
      "excludes": ["sourceRunId", "requestedAt", "warnings", "integrity", "localPath", "collectionMachine"]
    },
    "document": {
      "formula": ["sourceRunId", "canonicalUrl", "publishedAt", "contentHashBasis", "contentHashVersion", "contentSha256"],
      "excludes": ["documentId", "accessedAt", "warnings", "integrity", "localPath", "collectionMachine"]
    },
    "observation": {
      "formula": ["kind", "subject", "statement", "occurredAt", "asOf", "marketScopes", "topics", "entities", "evidenceState", "basis"],
      "sortBeforeHash": ["marketScopes unique lexicographic", "topics unique lexicographic", "entities unique stable-string order", "basis by documentId, relation, locator, excerpt"],
      "entity": "nonempty string with at most 120 characters",
      "basisUniqueness": ["documentId", "relation", "locator", "excerpt"],
      "excludes": ["observationId", "warnings", "auditTime"]
    },
    "event": {
      "formula": ["eventType", "title", "occurredAt", "marketScopes", "topics", "observationIds"],
      "sortBeforeHash": ["marketScopes unique lexicographic", "topics unique lexicographic", "observationIds unique lexicographic"],
      "excludes": ["eventId", "warnings", "auditTime"]
    },
    "duplicateCluster": {
      "formula": ["method", "canonicalDocumentId", "memberDocumentIds"],
      "sortBeforeHash": ["memberDocumentIds unique lexicographic"],
      "excludes": ["clusterId", "warnings", "auditTime"]
    },
    "bundle": {
      "businessView": ["schemaVersion", "edition", "asOf", "window", "sourcePolicyVersion", "sourceRunIds", "documentIds", "observationBusinessViews", "eventBusinessViews", "duplicateClusterBusinessViews", "coverage"],
      "excludes": ["generatedAt", "warnings", "integrity", "sourceRun.requestedAt", "document.accessedAt", "auditFields", "localPath", "collectionMachine"]
    },
    "auditOnlyFields": {
      "sourceRun": ["requestedAt", "warnings"],
      "document": ["accessedAt", "warnings"],
      "bundle": ["generatedAt", "warnings"]
    },
    "stableArtifactViews": {
      "sourceRun": "complete source run minus auditOnlyFields and integrity.sha256",
      "document": "complete document minus auditOnlyFields and integrity.sha256",
      "bundle": "complete bundle minus auditOnlyFields and integrity.sha256"
    },
    "existingArtifactReuse": ["revalidate existing artifact", "compare businessSha256", "compare stable artifact view", "reuse existing artifact when both match", "fail closed on stable business differences"]
  },
  "evidenceStateRules": {
    "precedence": ["qualified contradicts produces conflicting", "authoritative primary supports produces confirmed", "at least two eligible independent publisherId values produces corroborated", "community/social-only supports produces unverified", "otherwise single-source"],
    "qualifiedContradictSourceClasses": ["official-primary", "company-filing", "exchange-market-data", "primary-research", "major-media", "specialist-media", "vendor-market-data", "vendor-estimate"],
    "eligibleCorroboratingSourceClasses": ["major-media", "specialist-media", "vendor-market-data", "vendor-estimate"],
    "constraints": ["qualified contradicts are deduplicated by duplicate cluster and publisherId", "publisherId, not display publisher, defines independence", "documents in one duplicate cluster contribute at most one publisher", "community/signal contradicts are unverified counter-signals only", "community/signal never participates in corroborated counting", "confirmed is direct source support and not proof of causal or future inference", "analysis-context confirmed only labels source analysis or method"]
  },
  "limits": {
    "statementMaxCharacters": 400,
    "excerptMaxCharacters": 500,
    "locatorMaxCharacters": 160,
    "entityMaxCharacters": 120,
    "minimumSupportsPerObservation": 1,
    "minimumDocumentsPerDuplicateCluster": 2,
    "timezone": "Asia/Shanghai",
    "bundleAsOfFormat": "YYYY-MM-DD",
    "windowDateFormat": "YYYY-MM-DD",
    "timestampFormat": "timezone-bearing ISO-8601"
  },
  "sourcePolicy": {
    "storedAllowed": ["official JSON/XML/RSS/Atom", "government public releases", "company formal announcements", "exchange disclosures", "publicly redistributable structured files"],
    "hashOnlyDefault": ["major-media pages", "specialist-media pages", "community pages", "social pages", "copyright-unclear pages"],
    "hashOnlyRetains": ["canonical URL", "response content SHA-256", "title and publishedAt", "minimal necessary evidence excerpt", "response status and collection audit metadata"],
    "noneRequired": ["unavailable", "rate_limited", "schema_changed", "robots or site terms prohibit collection", "source explicitly prohibited from collection or storage"],
    "policyBlockedStatus": "unavailable with a warning that collection is policy-prohibited, never schema_changed",
    "prohibited": ["robots rules bypass", "site-terms-prohibited automated access", "login bypass", "paywall bypass", "CAPTCHA bypass", "WAF evasion", "fabricated cookies or authentication", "hidden automation identity", "bulk retention of news full text", "sensitive personal data retention", "cookies", "tokens", "authentication headers", "personal data", "media image, video, or PDF binary download or embedding"]
  },
  "writerContextBoundary": {
    "researchBundleDirectToLuna": false,
    "futureContextInputs": {
      "quantitativeWriterPacket": ["schemaVersion", "artifactPath", "artifactSha256", "writerPacketId"],
      "qualitativeResearchBundle": ["schemaVersion", "artifactPath", "artifactSha256", "bundleId"],
      "baselineContent": ["schemaVersion", "artifactPath", "artifactSha256", "contentIdentity"],
      "contextFields": ["writerPromptSha256", "targetSchemaVersion", "validatorSha256"]
    },
    "p1fTransition": "writer-request-v1 will be upgraded or replaced in P1-H; P1-GA does not modify P1-F code"
  },
  "forbiddenKeys": ["body", "html", "rawHtml", "fullText", "articleText", "transcript", "imageData", "pdfBytes", "base64", "cookies", "cookie", "authorization", "authToken", "accessToken", "probability", "modelProbability", "expectedReturn", "EvidenceScore", "evidenceScore", "ranking", "publicationStatus", "modelVersion", "prediction", "importance", "sentiment"]
}
