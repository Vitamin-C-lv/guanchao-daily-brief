      "coverageMarketRequiredKeys": ["documentCount", "market", "observationCount", "reasons", "status"],
      "coverageRequiredKeys": ["markets", "topics", "totals"],
      "coverageTopicAllowedKeys": ["documentCount", "observationCount", "reasons", "status", "topic"],
      "coverageTopicRequiredKeys": ["documentCount", "observationCount", "reasons", "status", "topic"],
      "coverageTotalsAllowedKeys": ["conflictingObservations", "documents", "duplicateClusters", "events", "observations", "sourceRuns"],
      "coverageTotalsRequiredKeys": ["conflictingObservations", "documents", "duplicateClusters", "events", "observations", "sourceRuns"],
      "duplicateClusterAllowedKeys": ["canonicalDocumentId", "clusterId", "memberDocumentIds", "method"],
      "duplicateClusterRequiredKeys": ["canonicalDocumentId", "clusterId", "memberDocumentIds", "method"],
      "eventAllowedKeys": ["eventId", "eventType", "marketScopes", "observationIds", "occurredAt", "title", "topics"],
      "eventRequiredKeys": ["eventId", "eventType", "marketScopes", "observationIds", "occurredAt", "title", "topics"],
      "integrityAllowedKeys": ["businessSha256", "sha256"],
      "integrityRequiredKeys": ["businessSha256", "sha256"],
      "observationAllowedKeys": ["asOf", "basis", "entities", "evidenceState", "kind", "marketScopes", "observationId", "occurredAt", "statement", "subject", "topics", "warnings"],
      "observationRequiredKeys": ["asOf", "basis", "entities", "evidenceState", "kind", "marketScopes", "observationId", "occurredAt", "statement", "subject", "topics", "warnings"],
      "requiredKeys": ["asOf", "bundleId", "coverage", "documents", "duplicateClusters", "edition", "events", "generatedAt", "integrity", "observations", "schemaVersion", "sourcePolicyVersion", "sourceRuns", "warnings", "window"],
      "windowAllowedKeys": ["end", "start", "timezone"],
      "windowRequiredKeys": ["end", "start", "timezone"]
    },
    "research-document-v1": {
      "allowedKeys": ["accessedAt", "canonicalUrl", "contentHashBasis", "contentHashVersion", "contentSha256", "contentType", "documentId", "integrity", "language", "marketScopes", "publishedAt", "publishedDate", "publisher", "publisherId", "rawSnapshotId", "sourceId", "sourceRunId", "title", "topics", "warnings"],
      "integrityAllowedKeys": ["businessSha256", "sha256"],
      "integrityRequiredKeys": ["businessSha256", "sha256"],
      "requiredKeys": ["accessedAt", "canonicalUrl", "contentHashBasis", "contentHashVersion", "contentSha256", "contentType", "documentId", "integrity", "language", "marketScopes", "publishedAt", "publishedDate", "publisher", "publisherId", "rawSnapshotId", "sourceId", "sourceRunId", "title", "topics", "warnings"]
    },
